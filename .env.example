# ============================================================
# AE Training Dashboard 2026 - Environment Variables
# ============================================================
# CATATAN KEAMANAN:
# - Variabel berawalan VITE_ akan diekspos ke browser client-side.
# - Variabel backend TANPA prefix VITE_ hanya berada di server / Edge Functions.
# - JANGAN PERNAH memasukkan SUPABASE_SERVICE_ROLE_KEY di frontend!

# ------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Client-side / Vite)
# ------------------------------------------------------------
# URL Project Supabase Anda (didapatkan dari Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (Aman digunakan di browser dengan RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nama Aplikasi
VITE_APP_NAME="AE Training Dashboard 2026"

# ------------------------------------------------------------
# 2. BACKEND / EDGE FUNCTION SECRETS (Server-side ONLY)
# ------------------------------------------------------------
# Masukkan nilai-nilai berikut di Supabase Dashboard -> Project Settings -> Secrets
# ATAU gunakan perintah CLI: supabase secrets set KEY=VALUE

# Supabase Service Role Key (Hanya untuk server backend/Edge Function dengan bypass RLS terkendali)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Cloud Service Account Email yang memiliki akses pembaca ke spreadsheet
# GOOGLE_SERVICE_ACCOUNT_EMAIL=ae-training-sync@project-id.iam.gserviceaccount.com

# Private Key dari Service Account (sertakan baris BEGIN dan END)
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ID Spreadsheet Google Sheets pendaftaran (terdapat pada URL docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
# GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id-here

# Nama Sheet Tab formulir (Contoh default: "Form Responses 1" atau "Jawaban Formulir 1")
# GOOGLE_SHEET_TAB_NAME="Form Responses 1"
